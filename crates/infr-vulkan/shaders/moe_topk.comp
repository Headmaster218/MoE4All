#version 460
#ifdef SUBGROUP_REDUCE
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
// MoE router top-k on the GPU (one workgroup, 128 lanes): top-`n_used` over `n_expert` logits →
// selected expert ids + weights, all in VRAM. Mirrors the host `moe_topk` (max-shift, top-k by
// logit, weight by gating function, optional renorm over the selected set, × routing scale) so an
// on-GPU router can drive the expert matmuls with no host round-trip.
//
// `gating` (0 = softmax, 1 = sigmoid, 2 = sqrt(softplus)) and `norm_w` (renormalize the selected
// weights to sum to 1) are independent push-constant flags.
//
// DeepSeek V2+ extensions:
//   * `has_bias` — router bias (exp_probs_b) is added to the GATED selection probs (`probs +
//     bias`, llama.cpp `selection_probs = ggml_add(probs, exp_probs_b)`), affecting SELECTION
//     only; weights come from the unbiased probs. This breaks the old monotonicity invariant
//     (top-k-by-logit ≠ top-k-by-score) — see `sel_score`.
//   * `n_expert_groups` / `n_expert_groups_used` — group-limited routing: per-group top-2 scores
//     are summed for a group score; the top `n_expert_groups_used` groups are kept, the rest
//     masked to -inf (matching llama.cpp `build_moe_ffn`).
//
// When neither extension is active (has_bias==0 && n_expert_groups<=1), this is byte-identical to
// the previous version — the thread-0 pre-phase sets `ssel_adj` to all zeros, and every lane adds
// zero to its local scores, so the arithmetic is unchanged.
//
// DeepSeek V4 HASH ROUTING (`hash != 0`): the selection arrives pre-gathered in `hash_ids`
// (`ffn_gate_tid2eid` indexed by token id, llama.cpp's `selected_experts_in`). Everything above
// the weight phase — the `ssel_adj` pre-fill, the per-lane sentinel loads, and the whole `n_used`
// reduction — is SKIPPED, not run and overwritten: it exists only to rank experts. The weight
// phase is unchanged and needs no special case, because `build_moe_ffn` takes the weights from
// `ggml_get_rows(probs, selected_experts)` on both paths — it already reads `ids[]` rather than
// its own picks. `has_bias`/`n_expert_groups` are selection-only and the host refuses them here.
//
// General `n_expert`: each lane owns `ceil(n_expert / 128)` experts (lane `t` owns `t, t+128,
// t+256, ...`, up to MAX_CHUNKS). Out-of-range/absent slots load the -1e30 sentinel.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PC {
    uint n_expert;
    uint n_used;
    float scale;
    uint gating;          // 0 = softmax, 1 = sigmoid, 2 = sqrt(softplus)
    uint norm_w;          // 1 = renormalize the selected weights to sum to 1 before scaling
    uint has_bias;        // 1 when exp_probs_b buffer is bound (DeepSeek V3+)
    uint n_expert_groups; // > 1 for group-limited routing (DeepSeek V3+)
    uint n_expert_groups_used; // how many groups to keep
    uint hash;            // 1 = take the selection from `hash_ids` (DeepSeek V4 hash-routed layer)
} pc;
// Binding order is INPUTS FIRST: the recorder marks the last N bound buffers as the dispatch's
// outputs for hazard tracking, so `hash_ids` (read-only) has to precede `ids`/`wts`.
layout(binding = 0) readonly buffer LB { float logits[]; };
layout(binding = 1) readonly buffer BB { float bias[]; }; // exp_probs_b, always bound
layout(binding = 2) readonly buffer HB { uint hash_ids[]; }; // tid2eid gather, always bound
layout(binding = 3) buffer IB { uint ids[]; };
layout(binding = 4) writeonly buffer WB { float wts[]; };

shared float sval[128];
shared uint sidx[128];
// Per-expert score adjustment: bias (if has_bias) + group mask. Thread 0 pre-fills.
// Keep this aligned with MAX_CHUNKS: 128 lanes * 8 chunks = 1024 experts (4 KiB shared).
shared float ssel_adj[1024];

// n_expert headroom: 128 lanes * 8 chunks = 1024 experts.
#define MAX_CHUNKS 8u

// WEIGHT score for one expert's (unbiased) logit. `mx` is the softmax shift and is used by the
// softmax branch only: it must be >= every logit this is called with, or `exp` overflows. It is a
// PARAMETER rather than a shared global because the right shift depends on which set the caller
// divides over, and the two callers divide over different sets — the renormalizing branch over the
// SELECTION (this function's callers, so `mx` is the selection max), the un-renormalized softmax
// branch over ALL experts (it computes its own `mx_all` inline; see B49 there). Renormalization
// cancels the shift algebraically, so a wrong shift surfaces only as overflow: `exp` past ~88.7 is
// +inf and inf/inf is NaN. Regression test `moe_topk_softmax_bias_shifts_by_selection_max`
// (recorder.rs) covers this function's shift; the un-renormalized branch's own shift is untested
// for the reason stated there.
float score_of(float logit, float mx) {
    if (pc.gating == 0u) {
        return exp(logit - mx);
    } else if (pc.gating == 1u) {
        return 1.0 / (1.0 + exp(-logit));
    } else {
        // gating == 2: sqrt(softplus) — sqrt(log(1 + exp(x))). Stable: for large x,
        // log(1+exp(x)) ≈ x, so sqrt(softplus(x)) ≈ sqrt(x). Use x when x > 20 to avoid
        // overflow in exp().
        float xx = (logit > 20.0) ? logit : log(1.0 + exp(logit));
        return sqrt(max(xx, 0.0));
    }
}

// SELECTION score for the bias/groups extension — the gated PROBABILITY plus the router bias,
// matching llama.cpp `selection_probs = ggml_add(probs, exp_probs_b)` (llama-graph.cpp:1882-1883)
// and the CPU interpreter (`sel_probs[e] = probs[e] + bias[e]`). The pre-extension code selected
// by raw logits, which is only equivalent when the bias is zero: sigmoid/sqrt-softplus are
// strictly monotone in the logit, so their prob ordering IS the logit ordering, but `probs + bias`
// is NOT monotone in `logits + bias`, so a real exp_probs_b model (V3/V3.1, sigmoid gated) would
// route to different experts under the old code. Softmax keeps the raw-logit ordering (monotone in
// the normalized prob; no real exp_probs_b model uses softmax gating).
float sel_score(float logit) {
    if (pc.gating == 0u) {
        return logit;
    } else if (pc.gating == 1u) {
        return 1.0 / (1.0 + exp(-logit));
    } else {
        float xx = (logit > 20.0) ? logit : log(1.0 + exp(logit));
        return sqrt(max(xx, 0.0));
    }
}

void select_topk(uint t, uint lbase, uint obase);
void weights_of(uint t, uint lbase, uint obase);

void main() {
    uint tok = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    uint lbase = tok * pc.n_expert;
    uint obase = tok * pc.n_used;

    // ── Hash-routed layer: copy the supplied selection in and jump straight to the weights ──
    // Lane 0 alone writes `ids`, exactly as the top-k path does, so the weight phase (also lane 0)
    // reads back its own writes and needs no cross-lane visibility. A lane-parallel copy would:
    // `barrier()` orders SHARED memory, not buffer memory, and would need an explicit
    // `memoryBarrierBuffer()` — not worth it for `n_used` (single digits) elements.
    if (pc.hash != 0u) {
        if (t == 0u) {
            for (uint k = 0u; k < pc.n_used; k++) {
                // Clamped for the same reason the top-k winner is: an out-of-range id would make
                // the downstream id-indexed GEMV read past the expert bank and fault the GPU.
                ids[obase + k] = min(hash_ids[obase + k], pc.n_expert - 1u);
            }
        }
    } else {
        select_topk(t, lbase, obase);
    }
    weights_of(t, lbase, obase);
}

// Top-`n_used` selection into `ids` — everything a hash-routed layer skips. `pc.hash` is a push
// constant, so the caller's branch is workgroup-uniform and the barriers below are reached by
// every lane or by none.
void select_topk(uint t, uint lbase, uint obase) {
    // ── Load per-lane logits ──
    float llog[MAX_CHUNKS];
    bool taken[MAX_CHUNKS];
    for (uint c = 0u; c < MAX_CHUNKS; c++) {
        uint e = t + c * 128u;
        llog[c] = (e < pc.n_expert) ? logits[lbase + e] : -1e30;
        taken[c] = false;
    }

    // ── Thread 0: pre-fill ssel_adj = bias + group mask ──
    if (t == 0u) {
        bool do_adj = (pc.has_bias != 0u) || (pc.n_expert_groups > 1u && pc.n_expert_groups_used > 0u);
        if (do_adj) {
            // Start with bias (or zero).
            for (uint e = 0u; e < pc.n_expert; e++) {
                ssel_adj[e] = (pc.has_bias != 0u) ? bias[e] : 0.0;
            }
            // Group-limited routing.
            uint ng = pc.n_expert_groups;
            uint ng_used = pc.n_expert_groups_used;
            if (ng > 1u && ng_used > 0u) {
                uint n_per = pc.n_expert / ng;
                // Compute per-group score: sum of top-2 within each group.
                float gscore[64]; // 256 experts / min 4 per group = max 64 groups
                for (uint g = 0u; g < ng; g++) {
                    float b0 = -1e30, b1 = -1e30;
                    uint base = g * n_per;
                    for (uint e = base; e < base + n_per; e++) {
                        float s = sel_score(logits[lbase + e]) + ssel_adj[e];
                        if (s > b0) { b1 = b0; b0 = s; }
                        else if (s > b1) { b1 = s; }
                    }
                    gscore[g] = b0 + b1;
                }
                // Select top ng_used groups (simple O(ng^2) selection — ng ≤ 64).
                bool chosen[64];
                for (uint g = 0u; g < ng; g++) { chosen[g] = false; }
                for (uint k = 0u; k < ng_used; k++) {
                    float best = -1e30;
                    uint bi = 0u;
                    for (uint g = 0u; g < ng; g++) {
                        if (!chosen[g] && gscore[g] > best) { best = gscore[g]; bi = g; }
                    }
                    chosen[bi] = true;
                }
                // Mask non-chosen groups: add -1e30 to their ssel_adj.
                for (uint g = 0u; g < ng; g++) {
                    if (!chosen[g]) {
                        uint base = g * n_per;
                        for (uint e = base; e < base + n_per; e++) {
                            ssel_adj[e] = -1e30;
                        }
                    }
                }
            }
        } else {
            // No extensions: ssel_adj stays zero — the lane-level arithmetic below is unchanged.
            for (uint e = 0u; e < pc.n_expert; e++) { ssel_adj[e] = 0.0; }
        }
    }
    barrier(); // ssel_adj published

    // ── Top-k selection (uses llog + ssel_adj) ──
    for (uint k = 0u; k < pc.n_used; k++) {
        float bv = -1e30;
        uint be = 0xFFFFFFFFu;
        for (uint c = 0u; c < MAX_CHUNKS; c++) {
            if (!taken[c]) {
                uint e = t + c * 128u;
                float s = (e < pc.n_expert) ? (sel_score(llog[c]) + ssel_adj[e]) : -1e30;
                if (s > bv) { bv = s; be = e; }
            }
        }
#ifdef SUBGROUP_REDUCE
        // Four pinned wave32 subgroups reduce locally, then subgroup 0 reduces their four winners.
        // Pairing max(score) with min(index among equal maxima) preserves the scalar tree's tie rule.
        float wave_best = subgroupMax(bv);
        uint wave_idx = subgroupMin(bv == wave_best ? be : 0xFFFFFFFFu);
        if (subgroupElect()) {
            sval[gl_SubgroupID] = wave_best;
            sidx[gl_SubgroupID] = wave_idx;
        }
        barrier();
        if (gl_SubgroupID == 0u) {
            float group_input = t < gl_NumSubgroups ? sval[t] : -1e30;
            float group_best = subgroupMax(group_input);
            uint group_idx = subgroupMin(
                group_input == group_best && t < gl_NumSubgroups ? sidx[t] : 0xFFFFFFFFu
            );
            if (t == 0u) { sidx[0] = group_idx; }
        }
        barrier();
#else
        sval[t] = bv;
        sidx[t] = be;
        barrier();
        for (uint s = 64u; s > 0u; s /= 2u) {
            if (t < s) {
                bool better = sval[t + s] > sval[t]
                    || (sval[t + s] == sval[t] && sidx[t + s] < sidx[t]);
                if (better) {
                    sval[t] = sval[t + s];
                    sidx[t] = sidx[t + s];
                }
            }
            barrier();
        }
#endif
        uint winner = sidx[0];
        // Clamp to the valid expert range. NaN logits make every `>` comparison false, so the
        // selection can end on the 0xFFFFFFFF sentinel (or any out-of-range slot); the downstream
        // idm indexes weights by this id, and an OOB id reads past the weight buffer → GPU fault.
        winner = min(winner, pc.n_expert - 1u);
        if (t == 0u) {
            ids[obase + k] = winner;
        }
        for (uint c = 0u; c < MAX_CHUNKS; c++) {
            if (t + c * 128u == winner) { taken[c] = true; }
        }
        barrier();
    }
}

// ── Weight computation (uses ORIGINAL unbiased logits) ── Runs on BOTH routing paths: llama.cpp
// takes the weights from `ggml_get_rows(probs, selected_experts)` whether the selection came from
// `ggml_argsort_top_k` or from the hash table, so this reads `ids[]` and never re-derives it.
void weights_of(uint t, uint lbase, uint obase) {
    if (t == 0u) {
        // The softmax shift: max of the ORIGINAL (unbiased) logits over the whole SELECTION, so
        // every `exp(logit - mx)` below has a non-positive exponent. It is the selection max and
        // not the first pick's logit, because a max over the first pick alone need not dominate
        // the rest once a router bias or group mask puts a non-maximal logit first.
        //
        // Used by the renormalizing branch only. There the shift cancels algebraically (every
        // weight is a ratio of two `exp`s carrying it), so any value >= every SELECTED logit is
        // correct, and this is the cheapest such value. The full-softmax branch below does NOT
        // cancel — its denominator runs over every expert, including unselected ones whose logit
        // can exceed this max — so it computes its own shift; see B49.
        float mx = -1e30;
        for (uint k = 0u; k < pc.n_used; k++) {
            float vl = logits[lbase + ids[obase + k]];
            if (vl > mx) { mx = vl; }
        }
        if (pc.norm_w != 0u) {
            float wsum_sel = 0.0;
            for (uint k = 0u; k < pc.n_used; k++) {
                wsum_sel += score_of(logits[lbase + ids[obase + k]], mx);
            }
            wsum_sel = max(wsum_sel, 1e-20);
            for (uint k = 0u; k < pc.n_used; k++) {
                wts[obase + k] = score_of(logits[lbase + ids[obase + k]], mx) / wsum_sel * pc.scale;
            }
        } else if (pc.gating == 0u) {
            // Softmax over ALL experts, un-renormalized: the weight of a selected expert is its
            // share of the full denominator, so the shift does NOT cancel out of the ratio — it
            // only cancels when numerator and denominator range over the same set.
            //
            // The shift must therefore dominate every expert's logit, not just the selected ones.
            // `mx` above is the max over the SELECTION, and selection is by `sel_score +
            // ssel_adj`: with a router bias or a group mask the largest raw logit can belong to an
            // expert that was NOT selected, and `exp(that - mx)` past ~88.7 is +inf, which takes
            // the whole denominator to +inf and every weight to 0. Same constant as the CPU oracle
            // (`Op::MoeFfn` in infr-cpu), which shifts by the max over all experts.
            //
            // NO GPU REGRESSION TEST GUARDS THIS, and one cannot be written in f32 on a
            // flush-to-zero device. A selected expert's weight is `1 / D`, where `D` is the
            // denominator the wrong shift computes; the bug needs `D` past f32's max (3.4e38) to
            // overflow, so the correct weight is always below 2.9e-39 — inside the subnormal
            // range. Measured on an RX 7900 XTX (RADV, no denorm-preserve execution mode): a
            // weight of 1.8e-35 comes back exactly, a weight of 5.5e-42 comes back as 0.0, so the
            // fixed and the broken kernel are indistinguishable there. See docs/backlog.md B49.
            float mx_all = -1e30;
            for (uint e = 0u; e < pc.n_expert; e++) {
                float vl = logits[lbase + e];
                if (vl > mx_all) { mx_all = vl; }
            }
            float full_sum = 0.0;
            for (uint e = 0u; e < pc.n_expert; e++) {
                full_sum += exp(logits[lbase + e] - mx_all);
            }
            full_sum = max(full_sum, 1e-20);
            for (uint k = 0u; k < pc.n_used; k++) {
                wts[obase + k] = exp(logits[lbase + ids[obase + k]] - mx_all) / full_sum * pc.scale;
            }
        } else {
            for (uint k = 0u; k < pc.n_used; k++) {
                wts[obase + k] = score_of(logits[lbase + ids[obase + k]], mx) * pc.scale;
            }
        }
    }
}
