#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Same fixed 0/1,2/3 pairing and scalar dequant/dot/reduction order as the measured prototype.
#if !defined(PAGED) || !defined(USE_GRID) || (!defined(FMT_IQ2S) && !defined(FMT_IQ3S))
#error VERIFY pairs require PAGED staged-grid IQ2S or IQ3S
#endif
#if defined(IQ2_GRID_BUFFER) || defined(IQ3_GRID_BUFFER)
#error VERIFY pairs must not replace buffer-codebook kernels
#endif
#ifndef NR
#define NR 1
#endif
#if (defined(FMT_IQ2S) && NR != 8) || (defined(FMT_IQ3S) && NR != 1)
#error Only IQ2S NR8 and IQ3S NR1 have measured pair thresholds
#endif
layout(local_size_x = 64) in;
layout(push_constant) uniform PC {
    uint in_f; uint out_f; uint n_used; uint stride; uint x_per_slot; uint rows;
    uint arena_lo; uint arena_hi; uint slot_bytes; uint active_mask; uint row_mask_bank;
#ifdef SHARED_Q8
    uint shared_lo; uint shared_hi; uint routed_used;
#endif
} pc;
layout(binding = 1) readonly buffer XB { float x_buf[]; };
layout(binding = 2) readonly buffer IDB { uint ids[]; };
layout(binding = 3) readonly buffer LUTB { uvec2 lut[]; };
layout(std430, binding = 4) readonly buffer MB { uint meta[]; };
layout(binding = 5) buffer YB { float y_buf[]; };

#include "native_weight_addr.glsl"
#define NW(i) arena_word(i)
#include "native_decode.glsl"

#ifdef SHARED_Q8
// Identical scalar Q8 decoder to native_gemv_id_multi.comp; shared slots never form pairs.
void dqblk_shared_q8(uint gstart, out float v[32]) {
    uint bd = (gstart / 32u) * 34u;
    float d = f16tof32(ru16(bd));
    uint qoff = bd + 2u;
    uint qwb = qoff >> 2u;
    uint qsh = (qoff & 3u) << 3u;
    uvec4 qA = NW4(qwb); uvec4 qB = NW4(qwb + 4u);
    if (qsh == 0u) {
        for (uint w8 = 0u; w8 < 8u; w8++) {
            int q4 = int((w8 < 4u) ? qA[w8] : qB[w8 - 4u]);
            for (uint b = 0u; b < 4u; b++) {
                v[w8 * 4u + b] = d * float(bitfieldExtract(q4, int(8u * b), 8));
            }
        }
    } else {
        uint qtail = NW(qwb + 8u);
        for (uint w8 = 0u; w8 < 8u; w8++) {
            uint qcur = (w8 < 4u) ? qA[w8] : qB[w8 - 4u];
            uint w1 = w8 + 1u;
            uint qnxt = (w1 < 4u) ? qA[w1] : ((w1 < 8u) ? qB[w1 - 4u] : qtail);
            int q4 = int((qcur >> qsh) | (qnxt << (32u - qsh)));
            for (uint b = 0u; b < 4u; b++) {
                v[w8 * 4u + b] = d * float(bitfieldExtract(q4, int(8u * b), 8));
            }
        }
    }
}
#endif

shared float part[2][NR][8];

uint routed_used() {
#ifdef SHARED_Q8
    return pc.routed_used;
#else
    return pc.n_used;
#endif
}

uint mask_for(uint row) {
    if (pc.row_mask_bank == 0u) return pc.active_mask;
    return ids[pc.rows * routed_used() + (pc.row_mask_bank - 1u) * pc.rows + row];
}

void main() {
    uint used = routed_used();
    if (pc.rows != 4u || used != 10u || pc.row_mask_bank > 2u
        || pc.in_f != 2560u || pc.out_f != 640u || pc.x_per_slot != 0u) return;
#ifdef SHARED_Q8
    if (pc.n_used != used + 1u) return;
#else
    if (pc.n_used != used) return;
#endif
    if (uint(meta.length()) < 128u || uint(ids.length()) < 48u
        || uint(x_buf.length()) < 4u * pc.in_f
        || uint(y_buf.length()) < 4u * pc.n_used * pc.out_f
        || meta[67] != 1u || meta[115] != pc.n_used) return;
    uint og = (pc.out_f + uint(NR) - 1u) / uint(NR);
    uint unit = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (unit >= pc.rows * pc.n_used * og) return;
    uint physical_a = unit / og;
    uint o0 = (unit - physical_a * og) * uint(NR);
    uint row = physical_a / pc.n_used;
    uint slot = physical_a % pc.n_used;
    if ((mask_for(row) & (1u << slot)) == 0u) return;
    bool is_shared = slot == used;
    uint a = row * used + slot;
    uint b = 0xffffffffu;
    bool paired = false;
    if (!is_shared) {
        b = meta[a];
        if (b < pc.rows * used) {
            paired = meta[b] == a && b / used == (row ^ 1u) && ids[b] == ids[a]
                && (mask_for(b / used) & (1u << (b % used))) != 0u;
        }
    }
    // A higher member is still a singleton when only its lower mate was masked out.
    if (paired && b < a) return;
    if (!is_shared) { GRID_INIT; }
#ifdef SHARED_Q8
    if (is_shared) w_addr = arena_base(pc.shared_lo, pc.shared_hi);
    else
#endif
    {
        uint length = uint(lut.length());
        if (pc.stride > length || ids[a] >= length - pc.stride) return;
        uvec2 address = lut[pc.stride + ids[a]];
        if (all(equal(address, uvec2(0u))) || all(equal(address, uvec2(0xffffffffu)))) return;
        w_addr = arena_base(address.x, address.y);
    }
    uint physical_b = paired ? (b / used) * pc.n_used + b % used : physical_a;
    uint x0 = row * pc.in_f;
    uint x1 = paired ? (b / used) * pc.in_f : x0;
    uint t = gl_LocalInvocationID.x;
    float acc0[NR], acc1[NR];
    for (uint rr = 0u; rr < uint(NR); rr++) { acc0[rr] = 0.0; acc1[rr] = 0.0; }
    for (uint s = t; s < pc.in_f / 32u; s += 64u) {
        for (uint rr = 0u; rr < uint(NR); rr++) {
            uint o = o0 + rr;
            if (o >= pc.out_f) continue;
            float v[32];
#ifdef SHARED_Q8
            if (is_shared) dqblk_shared_q8(o * pc.in_f + s * 32u, v);
            else
#endif
            dqblk(o * pc.in_f + s * 32u, v);
            float dot0 = 0.0;
            for (uint w = 0u; w < 32u; w++) dot0 += v[w] * x_buf[x0 + s * 32u + w];
            acc0[rr] += dot0;
            if (paired) {
                float dot1 = 0.0;
                for (uint w = 0u; w < 32u; w++) dot1 += v[w] * x_buf[x1 + s * 32u + w];
                acc1[rr] += dot1;
            }
        }
    }
    for (uint rr = 0u; rr < uint(NR); rr++) {
        float sg0 = subgroupAdd(acc0[rr]);
        if (subgroupElect()) part[0][rr][gl_SubgroupID] = sg0;
        if (paired) {
            float sg1 = subgroupAdd(acc1[rr]);
            if (subgroupElect()) part[1][rr][gl_SubgroupID] = sg1;
        }
    }
    barrier();
    if (t == 0u) {
        for (uint rr = 0u; rr < uint(NR); rr++) {
            uint o = o0 + rr;
            if (o >= pc.out_f) continue;
            float tot0 = 0.0;
            for (uint s = 0u; s < gl_NumSubgroups; s++) tot0 += part[0][rr][s];
            y_buf[physical_a * pc.out_f + o] = tot0;
            if (paired) {
                float tot1 = 0.0;
                for (uint s = 0u; s < gl_NumSubgroups; s++) tot1 += part[1][rr][s];
                y_buf[physical_b * pc.out_f + o] = tot1;
            }
        }
    }
}
