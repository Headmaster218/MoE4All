#version 460
// Qwen3.8 residual injection + per-stream RMSNorm + stream-specific norm weight.
// One workgroup owns one [n_embd] stream row and writes both the injected residual and the
// normalized low-rank projection input.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PC { uint hc; uint n_embd; float eps; } pc;
layout(binding = 0) readonly buffer RB { float residual[]; };
layout(binding = 1) readonly buffer BB { float block_out[]; };
layout(binding = 2) readonly buffer GB { float gate[]; };
layout(binding = 3) readonly buffer NB { float norm[]; };
layout(binding = 4) writeonly buffer RDB { float residual_dst[]; };
layout(binding = 5) writeonly buffer NDB { float normed_dst[]; };

shared float part[8];

void main() {
    uint rh = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationIndex;
    uint r = rh / pc.hc;
    uint h = rh - r * pc.hc;
    uint base = rh * pc.n_embd;
    float inject_scale = 2.0 / (1.0 + exp(-(gate[r * pc.hc + h] / float(pc.hc))));

    float ss = 0.0;
    for (uint d = t; d < pc.n_embd; d += 256u) {
        float value = residual[base + d] + block_out[r * pc.n_embd + d] * inject_scale;
        residual_dst[base + d] = value;
        ss += value * value;
    }
    ss = subgroupAdd(ss);
    if (subgroupElect()) { part[gl_SubgroupID] = ss; }
    barrier();

    float total = 0.0;
    for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) {
        total += part[subgroup];
    }
    float scale = inversesqrt(total / float(pc.n_embd) + pc.eps);
    uint norm_base = h * pc.n_embd;
    // Recompute the injected value instead of synchronizing and rereading residual_dst.
    for (uint d = t; d < pc.n_embd; d += 256u) {
        float value = residual[base + d] + block_out[r * pc.n_embd + d] * inject_scale;
        normed_dst[base + d] = value * scale * norm[norm_base + d];
    }
}
