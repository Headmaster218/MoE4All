#version 460
// DeepSeek V4 hyper-connection stream collapse (`Op::HyperConnectPre`, llama.cpp's
// `ggml_dsv4_hc_pre`): `dst[t, i] = sum_h x[t, h, i] * weights[t, h]`.
//
// One thread per output element (`total = rows*n_embd`); the `hc`-term sum is serial inside the
// thread and runs h ASCENDING, the accumulation order the reference's chain of `ggml_add`s builds.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint hc;
    uint n_embd;
    uint total;   // rows * n_embd
} pc;

layout(binding = 0) readonly buffer XB { float x[]; };
layout(binding = 1) readonly buffer WB { float w[]; };
layout(binding = 2) writeonly buffer DB { float dst[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) { return; }
    uint t = i / pc.n_embd;
    uint e = i - t*pc.n_embd;
    float acc = 0.0;
    for (uint h = 0u; h < pc.hc; ++h) {
        acc = fma(x[(t*pc.hc + h)*pc.n_embd + e], w[t*pc.hc + h], acc);
    }
    dst[i] = acc;
}
