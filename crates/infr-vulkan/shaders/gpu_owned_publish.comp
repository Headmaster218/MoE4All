#version 450
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Journal { uint journal[]; };
layout(std430, binding = 1) readonly buffer Jobs { uvec4 jobs[]; };
layout(std430, binding = 2) buffer Candidates { uvec4 nodes[]; };
layout(std430, binding = 3) buffer Overlay { uvec4 overlay[]; };
// mode 0: mapped payloads completed; mode 1: CPU transfers also completed.
layout(push_constant) uniform Params { uint ordinal; uint mode; } p;

const uint NONE = 0xffffffffu;
const uint JOB_CAPACITY = INFR_MAX_DECODE_ROWS * 16u * 3u;
const uint COUNT_WORD = INFR_MAX_DECODE_ROWS * 17u;
const uint STATUS_WORD = COUNT_WORD + 3u;
const uint JOURNAL_WORDS = STATUS_WORD + 1u;
shared uint valid, count, job_base, slot_count, pool_count, slot_base, address_base;
shared uint lane_valid[64];
bool fits(uint base, uint n, uint length) {
    return base <= length && n <= length - base;
}
bool valid_span(uvec2 a, uint bytes) {
    return any(notEqual(a, uvec2(0u))) && !all(equal(a, uvec2(NONE)))
        && bytes != 0u && ((a.x | bytes) & 15u) == 0u
        && (a.y != NONE || a.x <= NONE - (bytes - 1u));
}

bool initialize() {
    if (p.mode > 1u || p.ordinal >= uint(journal.length()) / JOURNAL_WORDS
        || p.ordinal >= uint(jobs.length()) / (JOB_CAPACITY * 2u)
        || uint(nodes.length()) < 3u || (nodes[0].x != 4u && nodes[0].x != 2u)) return false;
    uint base = p.ordinal * JOURNAL_WORDS;
    uint status = journal[base + STATUS_WORD];
    if (status != 4u && status != 5u) return false;
    count = journal[base + COUNT_WORD];
    if (count == 0u || count > JOB_CAPACITY) return false;
    slot_count = nodes[0].z;
    pool_count = nodes[0].y;
    uint pool_base = nodes[1].y;
    slot_base = nodes[1].z;
    address_base = nodes[1].w;
    uint length = uint(nodes.length());
    if (pool_base < 3u || pool_count == 0u || pool_count > (length - 3u) / 2u
        || !fits(pool_base, pool_count * 2u, length)
        || slot_base != pool_base + pool_count * 2u
        || !fits(slot_base, slot_count, length) || address_base < slot_base + slot_count
        || !fits(address_base, slot_count, length)) return false;
    job_base = p.ordinal * JOB_CAPACITY * 2u;
    return true;
}

bool valid_job(uint j) {
    uvec4 a = jobs[job_base + j * 2u], b = jobs[job_base + j * 2u + 1u];
    if (b.y >= uint(overlay.length()) || b.z >= slot_count
        || !valid_span(a.zw, b.x)
        || (any(notEqual(a.xy, uvec2(0u))) && !valid_span(a.xy, b.x))) return false;
    uvec4 slot = nodes[slot_base + b.z], address = nodes[address_base + b.z];
    uvec4 entry = overlay[b.y];
    if (address.z >= pool_count || address.w >= slot_count
        || slot.z != b.y || (slot.w != 1u && slot.w != 2u)
        || entry.z != slot.w || entry.w != b.z
        || any(notEqual(entry.xy, a.zw)) || any(notEqual(address.xy, a.zw))) return false;
    for (uint k = 0u; k < j; ++k) {
        uvec4 other = jobs[job_base + k * 2u + 1u];
        if (other.y == b.y || other.z == b.z) return false;
    }
    return true;
}

void main() {
    if (any(notEqual(gl_WorkGroupID, uvec3(0u)))) return;
    uint lane = gl_LocalInvocationIndex;
    if (lane == 0u) valid = uint(initialize());
    barrier();
    if (valid == 0u) return;
    // Every lane consumes the header result before any peer can reject a job.
    barrier();
    uint local_valid = 1u;
    for (uint j = lane; j < count; j += gl_WorkGroupSize.x)
        local_valid &= uint(valid_job(j));
    lane_valid[lane] = local_valid;
    // Validate the whole batch before publishing any slot; repeated publication is safe.
    // `barrier()` orders shared `valid`, but not the cross-lane SSBO reads above against
    // the nodes/overlay writes below. Publish only after those buffer reads are complete.
    memoryBarrierBuffer();
    barrier();
    if (lane == 0u) {
        for (uint i = 0u; i < gl_WorkGroupSize.x; ++i)
            valid &= lane_valid[i];
    }
    barrier();
    if (valid == 0u) return;
    for (uint j = lane; j < count; j += gl_WorkGroupSize.x) {
        uvec4 a = jobs[job_base + j * 2u], b = jobs[job_base + j * 2u + 1u];
        if (p.mode == 0u && all(equal(a.xy, uvec2(0u)))) continue;
        nodes[slot_base + b.z].w = 1u;
        overlay[b.y].z = 1u;
    }
}
