#version 460
// Ling gated-MLA output gate: one scalar per (row, head), broadcast over head_dim.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint rows;
    uint n_head;
    uint head_dim;
} pc;

layout(binding = 0) readonly buffer XB { float x[]; };
layout(binding = 1) readonly buffer GB { float gate[]; };
layout(binding = 2) writeonly buffer YB { float y[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint n = pc.rows * pc.n_head * pc.head_dim;
    if (i >= n) { return; }
    uint rh = i / pc.head_dim;
    float g = gate[rh];
    y[i] = x[i] / (1.0 + exp(-g));
}
