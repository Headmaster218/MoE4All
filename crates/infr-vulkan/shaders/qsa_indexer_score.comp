#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Score a 2-query x 4-block tile. Final block keys are materialized once by
// qsa_indexer_compress; this kernel only stages reusable Q/K data and computes the positive-head
// dot sum. A fixed wave32 pipeline gives eight subgroups, one per query/block pair.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint rows;
    uint kv_len;
    uint n_head;
    uint head_dim;
    uint ratio;
    float scale;
} pc;
layout(binding = 0) readonly buffer QB { uint q[]; };
layout(binding = 1) readonly buffer KB { float block_k[]; };
layout(binding = 2) writeonly buffer SB { float scores[]; };

shared float qtile[2][4][128];
shared float ktile[4][128];

float qread(uint i) {
    uint w = q[i >> 1u];
    uint h = (i & 1u) == 0u ? w & 0xffffu : w >> 16u;
    return unpackHalf2x16(h).x;
}

void main() {
    uint t = gl_LocalInvocationID.x;
    uint row_base = gl_WorkGroupID.y * 2u;
    uint block_base = gl_WorkGroupID.x * 4u;
    uint max_blocks = pc.kv_len / pc.ratio;

    for (uint i = t; i < 2u * 4u * 128u; i += 256u) {
        uint d = i & 127u;
        uint h = (i >> 7u) & 3u;
        uint qr = i >> 9u;
        uint row = row_base + qr;
        qtile[qr][h][d] = row < pc.rows && h < pc.n_head
            ? qread((row * pc.n_head + h) * pc.head_dim + d)
            : 0.0;
    }
    for (uint i = t; i < 4u * 128u; i += 256u) {
        uint d = i & 127u;
        uint bs = i >> 7u;
        uint block = block_base + bs;
        ktile[bs][d] = block < max_blocks
            ? block_k[block * pc.head_dim + d]
            : 0.0;
    }
    barrier();

    uint sg = gl_SubgroupID;
    uint qr = sg >> 2u;
    uint bs = sg & 3u;
    uint row = row_base + qr;
    uint block = block_base + bs;
    if (row >= pc.rows || block >= max_blocks) { return; }
    uint visible = pc.kv_len - pc.rows + row + 1u;
    if (block >= visible / pc.ratio) { return; }

    uint lane = gl_SubgroupInvocationID;
    float score = 0.0;
    for (uint h = 0u; h < pc.n_head; ++h) {
        float part = 0.0;
        for (uint d = lane; d < pc.head_dim; d += 32u) {
            part += qtile[qr][h][d] * ktile[bs][d];
        }
        score += max(subgroupAdd(part), 0.0);
    }
    if (lane == 0u) {
        scores[row * max_blocks + block] = score * pc.scale;
    }
}
