#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#ifdef KV_SEGMENTED
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
// Score a query/block tile. Final block keys are materialized once by qsa_indexer_compress; this
// kernel only stages reusable Q/K data and computes the positive-head dot sum. A fixed wave32
// pipeline gives eight subgroups, one per query/block pair. Decode uses 1 query x 8 blocks so no
// subgroup is idle; batched prefill keeps the established 2 queries x 4 blocks tile.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint rows;
    uint kv_len;
    uint n_head;
    uint head_dim;
    uint ratio;
    float scale;
    uint block_shift;
} pc;
layout(binding = 0) readonly buffer QB { uint q[]; };
#ifdef KV_SEGMENTED
layout(binding = 1) readonly buffer KB { uvec2 block_segments[]; };
#include "kv_addr.glsl"
#else
layout(binding = 1) readonly buffer KB { float block_k[]; };
#endif
layout(binding = 2) writeonly buffer SB { float scores[]; };

#ifdef QSA_SCORE_DECODE8
#define QUERY_TILE 1u
#define BLOCK_TILE 8u
#else
#define QUERY_TILE 2u
#define BLOCK_TILE 4u
#endif

shared float qtile[QUERY_TILE][4][128];
shared float ktile[BLOCK_TILE][128];

float qread(uint i) {
    uint w = q[i >> 1u];
    uint h = (i & 1u) == 0u ? w & 0xffffu : w >> 16u;
    return unpackHalf2x16(h).x;
}

#ifdef KV_SEGMENTED
uint64_t block_segment_address(uint segment) {
    uvec2 address = uvec2(0u);
    if (subgroupElect()) {
        address = block_segments[segment];
    }
    address.x = subgroupBroadcastFirst(address.x);
    address.y = subgroupBroadcastFirst(address.y);
    return kv_segment_base(address);
}

float block_read_local(uint64_t base, uint local) {
    return kv_f32(base, local);
}
#else
float block_read(uint i) {
    return block_k[i];
}
#endif

void main() {
    uint t = gl_LocalInvocationID.x;
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint row_base = gl_WorkGroupID.y * QUERY_TILE;
    uint block_base = gl_WorkGroupID.x * BLOCK_TILE;
    uint max_blocks = pc.kv_len / pc.ratio;

    for (uint i = t; i < QUERY_TILE * 4u * 128u; i += 256u) {
        uint d = i & 127u;
        uint h = (i >> 7u) & 3u;
        uint qr = i >> 9u;
        uint row = row_base + qr;
        qtile[qr][h][d] = row < pc.rows && h < pc.n_head
            ? qread((row * pc.n_head + h) * pc.head_dim + d)
            : 0.0;
    }
#ifdef KV_SEGMENTED
#ifdef QSA_SCORE_DECODE8
    uint load_bs = sg;
    uint d_base = 0u;
    const uint LOAD_COMPONENTS = 4u;
#else
    uint load_bs = sg >> 1u;
    uint d_base = (sg & 1u) * 64u;
    const uint LOAD_COMPONENTS = 2u;
#endif
    uint load_block = block_base + load_bs;
    if (load_block < max_blocks) {
        uint elem = load_block * pc.head_dim;
        uint64_t base = block_segment_address(kv_segment(elem, pc.block_shift));
        uint local_base = kv_segment_local(elem, pc.block_shift);
        for (uint component = 0u; component < LOAD_COMPONENTS; ++component) {
            uint d = d_base + lane + component * 32u;
            ktile[load_bs][d] = block_read_local(base, local_base + d);
        }
    } else {
        for (uint component = 0u; component < LOAD_COMPONENTS; ++component) {
            uint d = d_base + lane + component * 32u;
            ktile[load_bs][d] = 0.0;
        }
    }
#else
    for (uint i = t; i < BLOCK_TILE * 128u; i += 256u) {
        uint d = i & 127u;
        uint bs = i >> 7u;
        uint block = block_base + bs;
        ktile[bs][d] = block < max_blocks
            ? block_read(block * pc.head_dim + d)
            : 0.0;
    }
#endif
    barrier();

    uint qr = sg / BLOCK_TILE;
    uint bs = sg % BLOCK_TILE;
    uint row = row_base + qr;
    uint block = block_base + bs;
    if (row >= pc.rows || block >= max_blocks) { return; }
    uint visible = pc.kv_len - pc.rows + row + 1u;
    if (block >= visible / pc.ratio) { return; }

    float score = 0.0;
#ifdef QSA_SCORE_H4
    vec4 part = vec4(0.0);
    for (uint d = lane; d < 128u; d += 32u) {
        float key = ktile[bs][d];
        part += vec4(
            qtile[qr][0][d],
            qtile[qr][1][d],
            qtile[qr][2][d],
            qtile[qr][3][d]
        ) * key;
    }
    vec4 heads = subgroupAdd(part);
    score = max(heads.x, 0.0) + max(heads.y, 0.0)
        + max(heads.z, 0.0) + max(heads.w, 0.0);
#else
    for (uint h = 0u; h < pc.n_head; ++h) {
        float part = 0.0;
        for (uint d = lane; d < pc.head_dim; d += 32u) {
            part += qtile[qr][h][d] * ktile[bs][d];
        }
        score += max(subgroupAdd(part), 0.0);
    }
#endif
    if (lane == 0u) {
        scores[row * max_blocks + block] = score * pc.scale;
    }
}
