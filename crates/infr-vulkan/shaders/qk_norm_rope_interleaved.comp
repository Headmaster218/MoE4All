#version 460
// Fused per-head QK-norm + NEOX RoPE, reading from an INTERLEAVED q+g buffer.
// Eliminates the per-head CopyStrided dispatches for qwen35 attention layers.
// x[x_stride * row + h * 2*hd ..] = query elements for head h in row r.
// Output is packed [rows*nheads*hd] f16 like the non-interleaved kernel.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint rows; uint nheads; uint hd; uint rope_dim; float theta; uint rope_pos; uint out_base; float eps;
    uint src_stride;
#ifdef KV_BDA
    // -DKV_BDA (#74 slice 3): fused-K cache write by device address (kv_addr.glsl `k_addr`, d_lo/d_hi);
    // `y` binding disappears, cache stays bound inert for the barrier — see Recorder::
    // qk_norm_rope_interleaved_at.
    uint d_lo; uint d_hi;
#endif
} pc;
layout(binding = 0) readonly buffer XB { float x[]; };
layout(binding = 1) readonly buffer NB { float nw[]; };
#ifdef USE_PARAMS
layout(binding = 2) readonly buffer PB { uint p_pos; uint p_kvlen; };
#ifdef FREQ_FACTORS
layout(binding = 3) readonly buffer FF { float ff[]; };
#ifdef KV_SEGMENTED
layout(binding = 4) readonly buffer YB { uvec2 segments[]; };
#elif !defined(KV_BDA)
layout(binding = 4) buffer YB { float16_t y[]; };
#endif
#elif defined(KV_SEGMENTED)
layout(binding = 3) readonly buffer YB { uvec2 segments[]; };
#elif !defined(KV_BDA)
layout(binding = 3) buffer YB { float16_t y[]; };
#endif
#elif defined(FREQ_FACTORS)
layout(binding = 2) readonly buffer FF { float ff[]; };
#ifdef KV_SEGMENTED
layout(binding = 3) readonly buffer YB { uvec2 segments[]; };
#elif !defined(KV_BDA)
layout(binding = 3) buffer YB { float16_t y[]; };
#endif
#elif defined(KV_SEGMENTED)
layout(binding = 2) readonly buffer YB { uvec2 segments[]; };
#elif !defined(KV_BDA)
layout(binding = 2) buffer YB { float16_t y[]; };
#endif
#ifdef KV_BDA
#include "kv_addr.glsl"
#ifdef KV_SEGMENTED
void kvw(uint idx, float val) {
    uint shift = uint(findMSB((pc.nheads * pc.hd) << 15u));
    uint seg = kv_segment(idx, shift);
    kv_store_half(kv_segment_base(segments[seg]), kv_segment_local(idx, shift), val);
}
#define KVW(idx, val) kvw((idx), (val))
#else
#define KVW(idx, val) kv_store_half(k_addr, (idx), (val))
#endif
#else
#define KVW(idx, val) y[idx] = float16_t(val)
#endif

shared float xs[512];
shared float red[64];

void main() {
#if defined(KV_BDA) && !defined(KV_SEGMENTED)
    k_addr = kv_base(pc.d_lo, pc.d_hi);
#endif
    uint t = gl_LocalInvocationID.x;
    uint unit = gl_WorkGroupID.x;
    uint h = unit % pc.nheads;
    uint r = unit / pc.nheads;
    // Interleaved source: stride = nh*2*hd per row, query for head h at offset h*2*hd within row
    uint in_base = r * pc.src_stride + h * 2u * pc.hd;

    float pss = 0.0;
    for (uint i = t; i < pc.hd; i += 64u) { float v = x[in_base + i]; xs[i] = v; pss += v * v; }
    red[t] = pss;
    barrier();
    for (uint stride = 32u; stride > 0u; stride /= 2u) {
        if (t < stride) { red[t] += red[t + stride]; }
        barrier();
    }
    float scale = inversesqrt(red[0] / float(pc.hd) + pc.eps);

#ifdef USE_PARAMS
    uint rope_pos = p_pos;
    uint out_base = pc.out_base * p_pos;
#else
    uint rope_pos = pc.rope_pos;
    uint out_base = pc.out_base;
#endif
    uint absp = rope_pos + r;
    uint out_base_idx = ((out_base + r) * pc.nheads + h) * pc.hd;
    uint hf = pc.rope_dim / 2u;
    for (uint p = t; p < hf; p += 64u) {
        uint i0 = p;
        uint i1 = p + hf;
        float a = xs[i0] * scale * nw[i0];
        float b = xs[i1] * scale * nw[i1];
        float freq = pow(pc.theta, -2.0 * float(p) / float(pc.rope_dim));
        float ang = float(absp) * freq;
#ifdef FREQ_FACTORS
        ang /= ff[p];
#endif
        float s = sin(ang);
        float co = cos(ang);
        KVW(out_base_idx + i0, a * co - b * s);
        KVW(out_base_idx + i1, a * s + b * co);
    }
    for (uint i = pc.rope_dim + t; i < pc.hd; i += 64u) {
        KVW(out_base_idx + i, xs[i] * scale * nw[i]);
    }
}
