#version 460
#ifdef KV_SEGMENTED
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif
// Gather selected complete QSA blocks and the incomplete causal tail into packed-F16 scratch.
// KQ8/VQ8 read infr's planar KV layout: int8 codes in [0, cap), then one f16 scale per 32 codes.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint selected;
    uint complete;
    uint tail;
    uint ratio;
    uint row_pairs;
    uint total_pairs;
    uint kcap;
    uint vcap;
    uint segment_shift;
} pc;
#ifdef KV_SEGMENTED
layout(binding = 0) readonly buffer KB { uvec2 k_segments[]; };
layout(binding = 1) readonly buffer VB { uvec2 v_segments[]; };
#include "kv_addr.glsl"
#else
layout(binding = 0) readonly buffer KB { uint k[]; };
layout(binding = 1) readonly buffer VB { uint v[]; };
#endif
layout(binding = 2) readonly buffer IB { uint indices[]; };
#ifdef QSA_GATHER_X4
layout(binding = 3) writeonly buffer KDB { uvec2 kd[]; };
layout(binding = 4) writeonly buffer VDB { uvec2 vd[]; };
#else
layout(binding = 3) writeonly buffer KDB { uint kd[]; };
layout(binding = 4) writeonly buffer VDB { uint vd[]; };
#endif

#if defined(KQ8) || defined(KV_SEGMENTED)
float kread(uint i) {
#ifdef KV_SEGMENTED
    uint local = kv_segment_local(i, pc.segment_shift);
    uint64_t base = kv_segment_base(k_segments[kv_segment(i, pc.segment_shift)]);
#ifdef KQ8
    int codes = int(kv_word(base, local >> 2u));
    int code = bitfieldExtract(codes, int((local & 3u) * 8u), 8);
    uint block = local >> 5u;
    uint segment_elems = 1u << pc.segment_shift;
    float scale = unpackHalf2x16(
        kv_word(base, (segment_elems >> 2u) + (block >> 1u))
    )[block & 1u];
    return scale * float(code);
#else
    return kv_half(base, local);
#endif
#else
    int codes = int(k[i >> 2u]);
    int code = bitfieldExtract(codes, int((i & 3u) * 8u), 8);
    uint block = i >> 5u;
    float scale = unpackHalf2x16(k[(pc.kcap >> 2u) + (block >> 1u)])[block & 1u];
    return scale * float(code);
#endif
}
#endif

#if defined(VQ8) || defined(KV_SEGMENTED)
float vread(uint i) {
#ifdef KV_SEGMENTED
    uint local = kv_segment_local(i, pc.segment_shift);
    uint64_t base = kv_segment_base(v_segments[kv_segment(i, pc.segment_shift)]);
#ifdef VQ8
    int codes = int(kv_word(base, local >> 2u));
    int code = bitfieldExtract(codes, int((local & 3u) * 8u), 8);
    uint block = local >> 5u;
    uint segment_elems = 1u << pc.segment_shift;
    float scale = unpackHalf2x16(
        kv_word(base, (segment_elems >> 2u) + (block >> 1u))
    )[block & 1u];
    return scale * float(code);
#else
    return kv_half(base, local);
#endif
#else
    int codes = int(v[i >> 2u]);
    int code = bitfieldExtract(codes, int((i & 3u) * 8u), 8);
    uint block = i >> 5u;
    float scale = unpackHalf2x16(v[(pc.vcap >> 2u) + (block >> 1u)])[block & 1u];
    return scale * float(code);
#endif
}
#endif

#ifdef QSA_GATHER_X4
uvec2 q8x4(int codes, float scale) {
    return uvec2(
        packHalf2x16(vec2(
            scale * float(bitfieldExtract(codes, 0, 8)),
            scale * float(bitfieldExtract(codes, 8, 8))
        )),
        packHalf2x16(vec2(
            scale * float(bitfieldExtract(codes, 16, 8)),
            scale * float(bitfieldExtract(codes, 24, 8))
        ))
    );
}

void main() {
    uint group = gl_GlobalInvocationID.x;
    uint pair = group * 2u;
    if (pair >= pc.total_pairs) { return; }
    uint out_row = pair / pc.row_pairs;
    uint in_row = pair % pc.row_pairs;
    if (in_row + 1u >= pc.row_pairs) { return; }
    uint selected_rows = pc.selected * pc.ratio;
    uint src_row;
    if (out_row < selected_rows) {
        uint slot = out_row / pc.ratio;
        src_row = indices[slot] * pc.ratio + out_row % pc.ratio;
    } else {
        src_row = pc.complete * pc.ratio + out_row - selected_rows;
    }
    uint src_elem = (src_row * pc.row_pairs + in_row) * 2u;

#ifdef KV_SEGMENTED
    uint k_local = kv_segment_local(src_elem, pc.segment_shift);
    uint64_t k_base = kv_segment_base(k_segments[kv_segment(src_elem, pc.segment_shift)]);
    uint k_codes = kv_word(k_base, k_local >> 2u);
    uint k_block = k_local >> 5u;
    uint k_scale_word = kv_word(
        k_base,
        ((1u << pc.segment_shift) >> 2u) + (k_block >> 1u)
    );
    float k_scale = unpackHalf2x16(k_scale_word)[k_block & 1u];

    uint v_local = kv_segment_local(src_elem, pc.segment_shift);
    uint64_t v_base = kv_segment_base(v_segments[kv_segment(src_elem, pc.segment_shift)]);
    uint v_codes = kv_word(v_base, v_local >> 2u);
    uint v_block = v_local >> 5u;
    uint v_scale_word = kv_word(
        v_base,
        ((1u << pc.segment_shift) >> 2u) + (v_block >> 1u)
    );
    float v_scale = unpackHalf2x16(v_scale_word)[v_block & 1u];
#else
    uint k_codes = k[src_elem >> 2u];
    uint k_block = src_elem >> 5u;
    float k_scale = unpackHalf2x16(
        k[(pc.kcap >> 2u) + (k_block >> 1u)]
    )[k_block & 1u];

    uint v_codes = v[src_elem >> 2u];
    uint v_block = src_elem >> 5u;
    float v_scale = unpackHalf2x16(
        v[(pc.vcap >> 2u) + (v_block >> 1u)]
    )[v_block & 1u];
#endif

    kd[group] = q8x4(int(k_codes), k_scale);
    vd[group] = q8x4(int(v_codes), v_scale);
}
#else
void main() {
    uint pair = gl_GlobalInvocationID.x;
    if (pair >= pc.total_pairs) { return; }
    uint out_row = pair / pc.row_pairs;
    uint in_row = pair % pc.row_pairs;
    uint selected_rows = pc.selected * pc.ratio;
    uint src_row;
    if (out_row < selected_rows) {
        uint slot = out_row / pc.ratio;
        src_row = indices[slot] * pc.ratio + out_row % pc.ratio;
    } else {
        src_row = pc.complete * pc.ratio + out_row - selected_rows;
    }
    uint src_pair = src_row * pc.row_pairs + in_row;
#if defined(KQ8) || defined(KV_SEGMENTED)
    uint ke = src_pair * 2u;
    kd[pair] = packHalf2x16(vec2(kread(ke), kread(ke + 1u)));
#else
    kd[pair] = k[src_pair];
#endif
#if defined(VQ8) || defined(KV_SEGMENTED)
    uint ve = src_pair * 2u;
    vd[pair] = packHalf2x16(vec2(vread(ve), vread(ve + 1u)));
#else
    vd[pair] = v[src_pair];
#endif
}
#endif
