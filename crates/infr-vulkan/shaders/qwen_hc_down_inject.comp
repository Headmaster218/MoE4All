#version 460
#extension GL_EXT_control_flow_attributes : require
// Qwen3.8 single-row HC bottleneck: one Q8_0 down projection followed by scaled SiLU, plus the
// tiny independent F32 inject projection. One workgroup owns one output row from either weight.
// The Q8 arm mirrors native_gemv.comp; the F32 arm mirrors linear_f32r.comp -DVEC4.
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint in_f;
    uint low_rank;
    uint hc;
    float silu_scale;
    uint down_lo;
    uint down_hi;
    uint inject_lo;
    uint inject_hi;
} pc;

layout(binding = 0) readonly buffer XB { float x_buf[]; };
layout(binding = 1) writeonly buffer LowB { float low_buf[]; };
layout(binding = 2) writeonly buffer InjectB { float inject_buf[]; };

shared float red[64];

#include "native_weight_addr.glsl"
#define NW(i) arena_word(i)
#define FMT_Q8_0
#include "native_decode.glsl"

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer F32W { vec4 v[]; };

float q8_sub(uint gstart, uint xoff) {
    float v[32];
    dqblk(gstart, v);
    float a = 0.0;
    for (uint w = 0u; w < 32u; w++) { a += v[w] * x_buf[xoff + w]; }
    return a;
}

#ifdef HC_PF
struct Q8Raw {
    float d;
    uint qsh;
    uvec4 qa;
    uvec4 qb;
    uint tail;
};

Q8Raw q8_load(uint gstart) {
    uint bd = (gstart / 32u) * 34u;
    Q8Raw q;
    q.d = f16tof32(ru16(bd));
    uint qoff = bd + 2u;
    uint qwb = qoff >> 2u;
    q.qsh = (qoff & 3u) << 3u;
    q.qa = NW4(qwb);
    q.qb = NW4(qwb + 4u);
    q.tail = q.qsh == 0u ? 0u : NW(qwb + 8u);
    return q;
}

void q8_decode(Q8Raw q, out float v[32]) {
    for (uint w8 = 0u; w8 < 8u; ++w8) {
        uint qcur = w8 < 4u ? q.qa[w8] : q.qb[w8 - 4u];
        uint packed = qcur;
        if (q.qsh != 0u) {
            uint w1 = w8 + 1u;
            uint qnext = w1 < 4u ? q.qa[w1] : (w1 < 8u ? q.qb[w1 - 4u] : q.tail);
            packed = (qcur >> q.qsh) | (qnext << (32u - q.qsh));
        }
        for (uint b = 0u; b < 4u; ++b) {
            v[w8 * 4u + b] =
                q.d * float(bitfieldExtract(int(packed), int(8u * b), 8));
        }
    }
}

float q8_dot(Q8Raw q, uint xoff) {
    float v[32];
    q8_decode(q, v);
    float a = 0.0;
    for (uint w = 0u; w < 32u; ++w) {
        a += v[w] * x_buf[xoff + w];
    }
    return a;
}
#endif

void main() {
    GRID_INIT;
    uint unit = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (unit >= pc.low_rank + pc.hc) { return; }
    uint t = gl_LocalInvocationID.x;
    float acc = 0.0;

    if (unit < pc.low_rank) {
        w_addr = arena_base(pc.down_lo, pc.down_hi);
        uint wbase = unit * pc.in_f;
        uint nsub = pc.in_f / 32u;
#ifdef HC_PF
        for (uint s0 = t; s0 < nsub; s0 += 64u * uint(HC_PF)) {
            Q8Raw prefetched[HC_PF];
            bool valid[HC_PF];
            [[unroll]] for (uint p = 0u; p < uint(HC_PF); ++p) {
                uint s = s0 + p * 64u;
                valid[p] = s < nsub;
                if (valid[p]) { prefetched[p] = q8_load(wbase + s * 32u); }
            }
            [[unroll]] for (uint p = 0u; p < uint(HC_PF); ++p) {
                uint s = s0 + p * 64u;
                if (valid[p]) { acc += q8_dot(prefetched[p], s * 32u); }
            }
        }
#else
        for (uint s = t; s < nsub; s += 64u) {
            acc += q8_sub(wbase + s * 32u, s * 32u);
        }
#endif
    } else {
        uint o = unit - pc.low_rank;
        uint64_t inject_addr = arena_base(pc.inject_lo, pc.inject_hi);
        F32W weights = F32W(inject_addr);
        uint nv = pc.in_f / 4u;
        uint wbase = o * nv;
        vec4 vacc = vec4(0.0);
        for (uint i = t; i < nv; i += 64u) {
            uint xbase = i * 4u;
            vec4 xv = vec4(
                x_buf[xbase], x_buf[xbase + 1u], x_buf[xbase + 2u], x_buf[xbase + 3u]
            );
            vacc += weights.v[wbase + i] * xv;
        }
        acc = (vacc.x + vacc.y) + (vacc.z + vacc.w);
    }

    red[t] = acc;
    barrier();
    for (uint stride = 32u; stride > 0u; stride /= 2u) {
        if (t < stride) { red[t] += red[t + stride]; }
        barrier();
    }
    if (t == 0u) {
        if (unit < pc.low_rank) {
            float v = red[0] * pc.silu_scale;
            low_buf[unit] = v / (1.0 + exp(-v));
        } else {
            inject_buf[unit - pc.low_rank] = red[0];
        }
    }
}
