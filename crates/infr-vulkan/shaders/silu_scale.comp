#version 460
// Qwen3.8 low-rank residual gate: y = silu(x * scale).
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PC { uint n; float scale; } pc;
layout(binding = 0) readonly buffer XB { float x[]; };
layout(binding = 1) writeonly buffer YB { float y[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    float v = x[i] * pc.scale;
    y[i] = v / (1.0 + exp(-v));
}
